FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI provider
AI_PROVIDER=mock
DEEPSEEK_API_KEY=
HUGGINGFACE_API_KEY=

# Payment provider placeholders
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
