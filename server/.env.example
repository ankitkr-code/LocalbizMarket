PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Firebase Admin
# Option 1: put a service account JSON file at server/firebase-service-account.json
# Option 2: set FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY
